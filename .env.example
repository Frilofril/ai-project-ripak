# Публічні параметри підключення до проєкту Supabase (Project Settings -> Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Облікові дані двох тестових користувачів для інтеграційних тестів (npm test)
# Акаунт А має мати роль 'редактор' у таблиці public.profiles, акаунт Б — роль 'співавтор'
TEST_USER_A_EMAIL=editor+a@example.com
TEST_USER_B_EMAIL=author+b@example.com
TEST_USER_PASSWORD=your-test-password-min-6-chars

# Налаштування провайдера мовної моделі для функції генерації чернетки статті (Ф8)
# Допустимі значення AI_PROVIDER: groq або gemini
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
